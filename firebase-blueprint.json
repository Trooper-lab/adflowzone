
{
  "description": "An application for managing ad account maintenance tasks, built by viber coder and Firebase Studio AI.",
  "entities": {
    "user": {
      "title": "User",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "The URL of the user's profile picture."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "employee"],
          "default": "admin"
        },
        "managerId": {
          "type": "string",
          "description": "The UID of the admin who manages this employee."
        }
      },
      "required": [
        "uid",
        "email"
      ]
    },
    "note": {
      "title": "Note",
      "description": "A simple note created by a user.",
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "description": "The content of the note."
        }
      },
      "required": [
        "content"
      ]
    },
    "parentClient": {
      "title": "Parent Client",
      "description": "Represents an agency or freelancer who is the direct customer of the AdFlow Zone user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The UID of the AdFlow Zone user who owns this client record."
        },
        "clientType": {
          "type": "string",
          "enum": [
            "agency",
            "freelancer"
          ]
        },
        "clientName": {
          "type": "string"
        },
        "clientContactPerson": {
          "type": "string"
        },
        "clientContactEmail": {
          "type": "string",
          "format": "email"
        },
        "clientUserEmail": {
          "type": "string",
          "format": "email",
          "description": "The email address the client will use to log in to the portal."
        },
        "clientWebsite": {
          "type": "string",
          "format": "uri"
        },
        "logoUrl": {
          "type": "string",
          "format": "uri"
        },
        "brandColors": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string"
            },
            "secondary": {
              "type": "string"
            }
          }
        },
        "internalNotes": {
          "type": "string"
        }
      },
      "required": [
        "ownerId",
        "clientType",
        "clientName",
        "clientContactPerson",
        "clientContactEmail",
        "clientUserEmail"
      ]
    },
    "childAccount": {
      "title": "Child Account",
      "description": "Represents a specific Google Ads account managed under a Parent Client.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The UID of the AdFlow Zone user who owns this client record."
        },
        "parentClientId": {
          "type": "string",
          "description": "The ID of the Parent Client this account belongs to."
        },
        "assignedEmployeeId": {
          "type": "string",
          "description": "The UID of the employee assigned to manage this account."
        },
        "nickname": {
          "type": "string",
          "description": "An internal label for the Google Ads account."
        },
        "googleAdsClientId": {
          "type": "string"
        },
        "googleAdsAccountName": {
          "type": "string"
        },
        "managementFee": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number"
            },
            "frequency": {
              "type": "string",
              "enum": [
                "monthly"
              ]
            }
          }
        },
        "monthlyClickBudget": {
          "type": "number",
          "description": "The allocated monthly budget for ad clicks."
        },
        "primaryGoal": {
          "type": "string",
          "enum": [
            "lead_generation",
            "ecommerce_sales",
            "brand_awareness",
            "app_installs",
            "other"
          ]
        },
        "kpisToTrack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "customKpis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targetKpiValues": {
          "type": "array",
          "description": "An array of objects, each mapping a selected KPI to its target value for the month.",
          "items": {
            "type": "object",
            "properties": {
              "kpi": { "type": "string" },
              "target": { "type": "number" }
            },
            "required": ["kpi", "target"]
          }
        },
        "connectedChecklists": {
          "type": "array",
          "description": "An array of checklists connected to this account with their schedule.",
          "items": {
            "type": "object",
            "properties": {
              "checklistId": {
                "type": "string"
              },
              "startDate": {
                "type": "string",
                "format": "date-time"
              },
              "frequency": {
                "type": "string",
                "enum": ["daily", "weekly", "monthly", "one-off"]
              },
              "lastRunAt": {
                  "type": "string",
                  "format": "date-time"
              },
              "skipCount": {
                "type": "number",
                "default": 0
              }
            },
            "required": ["checklistId", "startDate", "frequency"]
          }
        },
        "pendingTodoIds": {
            "type": "array",
            "description": "An array of IDs of todo documents that are pending for this account.",
            "items": {
                "type": "string"
            }
        },
        "kpiDataIds": {
            "type": "array",
            "description": "An array of IDs of kpiData documents that are pending for this account.",
            "items": {
                "type": "string"
            }
        },
        "checklistRunIds": {
          "type": "array",
          "description": "An array of IDs of checklistRun documents associated with this account.",
          "items": {
            "type": "string"
          }
        },
        "todoRunIds": {
          "type": "array",
          "description": "An array of IDs of todoRun documents associated with this account.",
          "items": {
            "type": "string"
          }
        },
        "reportIds": {
          "type": "array",
          "description": "An array of IDs of monthly report documents associated with this account.",
          "items": {
            "type": "string"
          }
        },
        "isPaused": {
          "type": "boolean",
          "description": "Whether the account is paused and hidden from overviews."
        }
      },
      "required": [
        "ownerId",
        "parentClientId",
        "nickname",
        "googleAdsClientId",
        "googleAdsAccountName",
        "primaryGoal",
        "kpisToTrack"
      ]
    },
    "checklistTemplate": {
      "title": "Checklist Template",
      "description": "A user-defined template for a recurring checklist.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The UID of the user who owns this checklist template."
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["id", "description"]
          }
        }
      },
      "required": ["ownerId", "name", "description", "tasks"]
    },
    "checklistRun": {
      "title": "Checklist Run",
      "description": "An instance of a checklist being completed for a specific child account.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the AdFlow user who performed the run."
        },
        "childAccountId": {
          "type": "string"
        },
        "checklistId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["in_progress", "complete", "skipped"]
        },
        "runAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "durationSeconds": {
          "type": "number",
          "description": "Total time spent on this run in seconds."
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskId": { "type": "string" },
              "description": { "type": "string" },
              "completed": { "type": "boolean" },
              "notes": { "type": "string" }
            },
            "required": ["taskId", "description", "completed"]
          }
        }
      },
      "required": ["ownerId", "childAccountId", "checklistId", "status", "runAt", "tasks"]
    },
    "kpiData": {
      "title": "KPI Data Point",
      "description": "A collection of KPI values for a specific period.",
      "type": "object",
      "properties": {
        "ownerId": {
            "type": "string",
            "description": "UID of the user who owns this data."
        },
        "childAccountId": {
            "type": "string"
        },
        "periodType": {
            "type": "string",
            "enum": ["monthly"]
        },
        "startDate": {
            "type": "string",
            "format": "date-time"
        },
        "kpiValues": {
            "type": "object",
            "description": "A map of KPI names to their numeric values for the period.",
            "additionalProperties": {
                "type": "number"
            }
        }
      },
      "required": ["ownerId", "childAccountId", "periodType", "startDate", "kpiValues"]
    },
    "todo": {
      "title": "Todo",
      "description": "A simple todo item associated with a user and a child account.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who created the todo."
        },
        "parentClientId": {
          "type": "string",
          "description": "The ID of the parent client this todo is associated with."
        },
        "parentClientName": {
            "type": "string",
            "description": "The name of the parent client."
        },
        "childAccountId": {
          "type": "string",
          "description": "The ID of the child account this todo belongs to."
        },
        "childAccountNickname": {
            "type": "string",
            "description": "The nickname of the child account."
        },
        "content": {
          "type": "string",
          "description": "The text content of the todo."
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the todo is completed or not."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the todo was created."
        },
        "dueDate": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the todo is due."
        }
      },
      "required": ["userId", "childAccountId", "content", "completed", "createdAt", "parentClientId", "parentClientName", "childAccountNickname"]
    },
    "todoRun": {
      "title": "Todo Run",
      "description": "An instance of a todo being completed.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the user who completed the todo."
        },
        "parentClientId": {
            "type": "string"
        },
        "childAccountId": {
          "type": "string"
        },
        "todoId": {
            "type": "string"
        },
        "content": {
            "type": "string"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "parentClientId", "childAccountId", "todoId", "content", "completedAt"]
    },
    "monthlyReport": {
      "title": "Monthly Report",
      "description": "A monthly performance report for a specific child account.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "childAccountId": { "type": "string" },
        "parentClientId": { "type": "string" },
        "period": { "type": "string", "description": "The reporting period, formatted as 'YYYY-MM'." },
        "status": { "type": "string", "enum": ["draft", "finalized", "sent", "confirmed", "skipped"] },
        "generatedAt": { "type": "string", "format": "date-time" },
        "kpiDataSnapshotId": { "type": "string" },
        "completedTodoRunIds": { "type": "array", "items": { "type": "string" } },
        "completedChecklistRunIds": { "type": "array", "items": { "type": "string" } },
        "aiSummary": { "type": "string" },
        "keyInsights": {
          "type": "array",
          "description": "Structured insights generated by AI.",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" },
              "impact": { "type": "string", "enum": ["high", "medium", "low"] },
              "category": { "type": "string" }
            },
            "required": ["title", "description", "impact", "category"]
          }
        },
        "privateNotes": { "type": "string" },
        "nextSteps": {
            "type": "array",
            "description": "AI-generated recommendations for the next period.",
            "items": {
                "type": "string"
            }
        },
        "lastEmailedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the report was last emailed to the client."
        }
      },
      "required": ["ownerId", "childAccountId", "parentClientId", "period", "status", "generatedAt"]
    },
    "project": {
      "title": "Project",
      "description": "A strategic project or trajectory for a client.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "parentClientId": { "type": "string" },
        "childAccountId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "on_hold"] },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "completed": { "type": "boolean" },
              "dueDate": { "type": "string", "format": "date-time" }
            },
            "required": ["id", "title", "completed"]
          }
        },
        "budget": { "type": "number" }
      },
      "required": ["ownerId", "parentClientId", "title", "status", "startDate", "milestones"]
    }
  },
  "auth": {
    "providers": [
      "email"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/user"
      },
      "description": "Stores user profile information."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": {
        "$ref": "#/entities/note"
      },
      "description": "Stores individual notes created by a specific user."
    },
    "/users/{userId}/todos/{todoId}": {
      "schema": {
        "$ref": "#/entities/todo"
      },
      "description": "Stores todo items for a specific user."
    },
    "/users/{userId}/checklistTemplates/{templateId}": {
      "schema": {
        "$ref": "#/entities/checklistTemplate"
      },
      "description": "Stores user-created checklist templates."
    },
    "/parentClients/{parentClientId}": {
      "schema": {
        "$ref": "#/entities/parentClient"
      },
      "description": "Stores information about parent clients (agencies/freelancers)."
    },
    "/parentClients/{parentClientId}/childAccounts/{childAccountId}": {
      "schema": {
        "$ref": "#/entities/childAccount"
      },
      "description": "Stores Google Ads accounts associated with a parent client."
    },
    "/kpiData/{kpiDataId}": {
        "schema": {
            "$ref": "#/entities/kpiData"
        },
        "description": "Stores time-series KPI data for a specific child account."
    },
    "/checklistRuns/{checklistRunId}": {
      "schema": {
        "$ref": "#/entities/checklistRun"
      },
      "description": "Stores instances of completed checklists for specific accounts."
    },
    "/todoRuns/{todoRunId}": {
        "schema": {
            "$ref": "#/entities/todoRun"
        },
        "description": "Stores instances of completed todos."
    },
    "/reports/{reportId}": {
        "schema": {
            "$ref": "#/entities/monthlyReport"
        },
        "description": "Stores monthly performance reports for child accounts."
    },
    "/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/project"
      },
      "description": "Stores strategic projects for clients."
    }
  }
}
