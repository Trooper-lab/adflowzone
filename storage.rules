
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to client logos
    match /client_logos/{clientId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow authenticated users to write to their own profile picture folder
    match /profile_pictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny all other routes
    match /{allPaths=**} {
        allow read, write: if false;
    }
  }
}
