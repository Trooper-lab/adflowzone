rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Safe admin check: handles missing user document gracefully
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ["billy@pearsonline.nl", "billy@trooper.es", "admin@onlyforward.nl"] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'Admin'])
      );
    }

    // Safe employee check: handles missing user document gracefully
    function isEmployee() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['employee', 'Employee'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // Child Accounts (Top-level for collectionGroup support)
    match /{path=**}/childAccounts/{childAccountId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isEmployee() || 
        resource.data.assignedEmployeeId == request.auth.uid ||
        (resource.data.get('assignedEmployees', [])).hasAny([request.auth.uid])
      );
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated() && (isAdmin() || isEmployee());
    }

    // Documents subcollection explicitly matched
    match /parentClients/{parentClientId}/childAccounts/{childAccountId}/documents/{documentId} {
        allow read, write: if isAuthenticated() && (
          isAdmin() || 
          isEmployee() ||
          get(/databases/$(database)/documents/parentClients/$(parentClientId)/childAccounts/$(childAccountId)).data.assignedEmployeeId == request.auth.uid ||
          (get(/databases/$(database)/documents/parentClients/$(parentClientId)/childAccounts/$(childAccountId)).data.get('assignedEmployees', [])).hasAny([request.auth.uid])
        );
    }

    // Parent Clients
    match /parentClients/{parentClientId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee());
      allow create, update, delete: if isAdmin();

    }

    // Checklist Runs
    match /checklistRuns/{runId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee() || isOwner(resource.data.ownerId));
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isOwner(resource.data.ownerId) ||
        (
          resource.data.get('parentClientId', 'X') != 'X' && 
          resource.data.get('childAccountId', 'Y') != 'Y' &&
          exists(/databases/$(database)/documents/parentClients/$(resource.data.get('parentClientId', 'X'))/childAccounts/$(resource.data.get('childAccountId', 'Y'))) &&
          get(/databases/$(database)/documents/parentClients/$(resource.data.get('parentClientId', 'X'))/childAccounts/$(resource.data.get('childAccountId', 'Y'))).data.get('assignedEmployeeId', '') == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    // Checklist Templates (subcollection of users)
    match /users/{userId}/checklistTemplates/{templateId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isEmployee());
    }

    // Collection Group rules for checklistTemplates (required for collectionGroup queries)
    match /{path=**}/checklistTemplates/{templateId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isEmployee());
    }

    // KPI Data
    match /kpiData/{kpiDataId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isEmployee());
    }

    // Campaign Performance
    match /campaignPerformance/{docId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isEmployee());
    }

    // Reports
    match /reports/{reportId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isEmployee());
    }

    // Todos
    match /users/{userId}/todos/{todoId} {
      allow read, write: if isOwner(userId) || isAdmin() || isEmployee();
    }

    // Collection Group rules for todos (required for collectionGroup queries)
    match /{path=**}/todos/{todoId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isEmployee());
    }

    // Projects
    match /projects/{projectId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isEmployee());
    }

    // Time Entries
    match /timeEntries/{entryId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isEmployee());
    }

    // Platform Feedback
    match /feedbacks/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Briefings
    match /briefings/{briefingId} {
      allow get: if isAuthenticated() || (resource.data.shareToken != null && resource.data.shareToken != "");
      allow list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    // Services
    match /services/{serviceId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isEmployee());
    }

    // Service Packages
    match /servicePackages/{packageId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isEmployee());
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
